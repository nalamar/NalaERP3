# Allgemeine Einstellungen
APP_ENV=development

# API
API_ADDR=:8080
API_LOG_LEVEL=info

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nalaerp
POSTGRES_USER=nala
POSTGRES_PASSWORD=secret
# Vollständige DSN (überschreibt obige Werte, wenn gesetzt)
POSTGRES_DSN=postgres://nala:secret@postgres:5432/nalaerp?sslmode=disable

# MongoDB
MONGO_URI=mongodb://mongo:27017
MONGO_DB=nalaerp

# Redis
REDIS_ADDR=redis:6379
REDIS_DB=0
REDIS_PASSWORD=secret

# Auth
# WICHTIG: bei APP_ENV=production verweigert der Server den Start, wenn
# JWT_SECRET kuerzer als 32 Zeichen ist (siehe internal/config.ValidateForStartup) -
# vor Produktivbetrieb einen sicheren, zufaelligen Wert setzen, z.B. via
# 'openssl rand -base64 32'.
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_MINUTES=15
SESSION_TTL_HOURS=12
# Rate-Limiting auf /auth/login: sperrt eine IP-Adresse nach zu vielen
# fehlgeschlagenen Anmeldeversuchen innerhalb des Zeitfensters.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Assets/Conversion
# DPI für EMF→PNG Konvertierung (Inkscape/ImageMagick/LibreOffice-PDF-Pfad)
EMF_PNG_DPI=300
EMF_PNG_MIN_WIDTH=600
EMF_PNG_TARGET_WIDTH=1200
