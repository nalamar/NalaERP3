      <BoQBody>
        <BoQCtgy ID="C2" RNoPart="01">
          <LblTx>
            <p><span>Stahlbau</span></p>
          </LblTx>
          <BoQBody>
            <Itemlist>
              <Remark ID="R3">
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p><span>Die Halle ist während der Montage beheizt; Anlieferung über die Laderampe.</span></p>
                      </Text>
                    </DetailTxt>
                  </CompleteText>
                </Description>
              </Remark>
              <Item ID="I4" RNoPart="0010">
                <Qty>2.000</Qty>
                <QU>St</QU>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p><span>Gerade Stahltreppe, Wangen U-Profil, Stufen Gitterrost, 16 Steigungen.</span></p>
                      </Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <p><span>Stahltreppe zur Bühne, gerade</span></p>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Item ID="I5" RNoPart="0020">
                <Qty>46.000</Qty>
                <QU>lfm</QU>
