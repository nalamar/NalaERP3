                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <p><span>Bühnengeländer Stahl</span></p>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Item ID="I6" RNoPart="0030">
                <Qty>38.000</Qty>
                <QU>m²</QU>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p><span>Bühne aus Walzprofilen, Belag Gitterrost 30/30, Nutzlast 5 kN/m².</span></p>
                      </Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <p><span>Wartungsbühne Stahl mit Gitterrost</span></p>
                        </TextOutlTxt>
                      </OutlTxt>
