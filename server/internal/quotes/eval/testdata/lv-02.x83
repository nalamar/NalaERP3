                    <ALNSerNo>0</ALNSerNo>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p><span>Pfosten-Riegel-Fassade wie vor, Felder mit Zweifach-Sonnenschutzverglasung.</span></p>
