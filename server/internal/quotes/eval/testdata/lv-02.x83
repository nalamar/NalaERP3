            <BoQCtgy ID="C3" RNoPart="01">
              <LblTx>
                <p><span>Pfosten-Riegel-Fassade</span></p>
              </LblTx>
              <BoQBody>
                <Itemlist>
                  <Remark ID="R4">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p><span>Die Fassade ist als geschlossene Hülle bis zur Abnahme zu schützen.</span></p>
                          </Text>
                        </DetailTxt>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Item ID="I5" RNoPart="0010">
                    <Qty>245.000</Qty>
                    <QU>m2</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p><span>Pfosten-Riegel-Konstruktion aus Aluminium, Systembreite 50 mm, Serie P50.</span></p>
                            <p><span>Verglasung 2-fach Sonnenschutzglas, Ucw ≤ 1,1 W/(m²K).</span></p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p><span>Pfosten-Riegel-Fassade Aluminium</span></p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I6" RNoPart="0020">
                    <Qty>80.000</Qty>
                    <QU>m2</QU>
