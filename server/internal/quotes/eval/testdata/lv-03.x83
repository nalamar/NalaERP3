  <Award>
    <DP>83</DP>
    <BoQ ID="Q1">
      <BoQInfo>
        <Name>lv-03</Name>
        <BoQBkdn><Type>BoQLevel</Type><Length>2</Length><Num>Yes</Num></BoQBkdn>
        <BoQBkdn><Type>BoQLevel</Type><Length>2</Length><Num>Yes</Num></BoQBkdn>
        <BoQBkdn><Type>Item</Type><Length>4</Length><Num>Yes</Num></BoQBkdn>
      </BoQInfo>
      <BoQBody>
        <BoQCtgy ID="C2" RNoPart="01">
          <LblTx>
            <p><span>Fenster</span></p>
          </LblTx>
          <BoQBody>
            <BoQCtgy ID="C3" RNoPart="01">
              <LblTx>
                <p><span>Erdgeschoss</span></p>
              </LblTx>
              <BoQBody>
                <Itemlist>
                  <Remark ID="R4">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p><span>Arbeiten im laufenden Schulbetrieb; lärmintensive Arbeiten nur in den Ferien.</span></p>
                          </Text>
                        </DetailTxt>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="R5">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p><span>Die Fenster werden geschossweise getauscht.</span></p>
                          </Text>
                        </DetailTxt>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Item ID="I6" RNoPart="0010">
                    <Qty>20.000</Qty>
                    <QU>Stk</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p><span>Bestehende Fenster mit Rahmen ausbauen, Material entsorgen.</span></p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p><span>Altfenster ausbauen</span></p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I7" RNoPart="0020">
                    <Qty>10.000</Qty>
                    <QU>Stk</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p><span>System Serie A75 o. glw.</span></p>
                            <p><span>Glasaufbau 4/12/4/12/4 mit Wärmeschutzbeschichtung (3-fach).</span></p>
                            <p><span>U-Wert Fenster 0,9.</span></p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p><span>Fenster Alu 1-flg. DK</span></p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I8" RNoPart="0030">
                    <Qty>6.000</Qty>
                    <QU>Stk</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p><span>Zweiflügeliges Fenster, System Serie A75, Uw-Wert: 0.90</span></p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p><span>Fenster Alu 2-flg.</span></p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I9" RNoPart="0040">
                    <Qty>2.000</Qty>
                    <QU>Stk</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p><span>Fenstertür in den Pausenhof, Uw 1,0 W/(m²K).</span></p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p><span>Fenstertür Alu</span></p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I10" RNoPart="0050">
                    <Qty>31.500</Qty>
                    <QU>m</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p><span>Aluminium, gekantet, eloxiert, Ausladung 160 mm.</span></p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p><span>Fensterbank außen Alu</span></p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I11" RNoPart="0060">
                    <Qty>31.500</Qty>
                    <QU>m</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
