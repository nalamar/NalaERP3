                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I18" RNoPart="0060">
                    <Qty>12.000</Qty>
                    <QU>Stk</QU>
