                              <p><span>Oberlichtfenster Kipp, Alu</span></p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I16" RNoPart="0040">
                    <Qty>8.000</Qty>
                    <QU>Stk</QU>
                    <ALNGroupNo>1</ALNGroupNo>
                    <ALNSerNo>1</ALNSerNo>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p><span>Alternativ zu 01.02.0030: Oberlicht als Festverglasung ohne Flügel.</span></p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p><span>wie vor, jedoch feststehend</span></p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
