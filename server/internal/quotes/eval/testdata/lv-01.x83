              <Item ID="I34" RNoPart="0010">
                <Qty>20.000</Qty>
                <QU>h</QU>
                <Provis>WithoutTotal</Provis>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p><span>Stundenlohnarbeiten nur auf schriftliche Anordnung.</span></p>
                      </Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <p><span>Stundenlohn Monteur</span></p>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Item ID="I35" RNoPart="0020">
                <Qty>1.000</Qty>
                <QU>psch</QU>
                <LumpSumItem>Yes</LumpSumItem>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p><span>Reinigung aller Rahmen und Gläser innen und außen vor der Abnahme.</span></p>
                      </Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <p><span>Schlussreinigung Fenster und Türen</span></p>
                        </TextOutlTxt>
                      </OutlTxt>
