                          <p><span>Außentreppe Stahl, gerade</span></p>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Item ID="I31" RNoPart="0030">
                <Qty>1.000</Qty>
                <QU>Stk</QU>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p><span>Vordach aus Stahlprofilen, Eindeckung VSG 2 x 8 mm, Größe 2,50 x 1,20 m.</span></p>
                      </Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <p><span>Vordach Eingang</span></p>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
