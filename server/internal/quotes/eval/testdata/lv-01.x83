<?xml version="1.0" encoding="UTF-8"?>
<GAEB xmlns="http://www.gaeb.de/GAEB_DA_XML/DA83/3.3">
  <GAEBInfo>
    <Version>3.3</Version>
    <ProgSystem>NalaERP3 Evaluationsset (synthetisch)</ProgSystem>
  </GAEBInfo>
  <PrjInfo>
    <NamePrj>lv-01</NamePrj>
    <LblPrj>Synthetisches Leistungsverzeichnis</LblPrj>
    <Cur>EUR</Cur>
  </PrjInfo>
  <Award>
    <DP>83</DP>
    <BoQ ID="Q1">
      <BoQInfo>
        <Name>lv-01</Name>
        <BoQBkdn><Type>BoQLevel</Type><Length>2</Length><Num>Yes</Num></BoQBkdn>
        <BoQBkdn><Type>Item</Type><Length>4</Length><Num>Yes</Num></BoQBkdn>
      </BoQInfo>
      <BoQBody>
        <BoQCtgy ID="C2" RNoPart="01">
          <LblTx>
            <p><span>Baustelleneinrichtung</span></p>
          </LblTx>
          <BoQBody>
            <Itemlist>
              <Remark ID="R3">
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p><span>Alle Maße sind am Bau zu nehmen.</span></p>
                      </Text>
                    </DetailTxt>
                  </CompleteText>
                </Description>
              </Remark>
              <Remark ID="R4">
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p><span>Angegebene Systeme gelten als Leitfabrikat; gleichwertige Systeme sind zulässig, die Gleichwertigkeit ist nachzuweisen.</span></p>
                      </Text>
                    </DetailTxt>
                  </CompleteText>
                </Description>
              </Remark>
              <Item ID="I5" RNoPart="0010">
                <Qty>1.000</Qty>
                <QU>psch</QU>
                <LumpSumItem>Yes</LumpSumItem>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p><span>Einrichten, Vorhalten und Räumen der Baustelleneinrichtung für das Gewerk Fenster und Türen.</span></p>
                      </Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <p><span>Baustelleneinrichtung einrichten und räumen</span></p>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
            </Itemlist>
          </BoQBody>
        </BoQCtgy>
        <BoQCtgy ID="C6" RNoPart="02">
          <LblTx>
            <p><span>Fenster und Fenstertüren</span></p>
          </LblTx>
          <BoQBody>
            <Itemlist>
              <Item ID="I7" RNoPart="0010">
                <Qty>12.000</Qty>
                <QU>Stk</QU>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p><span>Fenster aus wärmegedämmten Aluminiumprofilen, Profilsystem Serie A75.</span></p>
                        <p><span>Verglasung: Dreifach-Wärmeschutzverglasung.</span></p>
                        <p><span>Uw ≤ 0,90 W/(m²K). Größe 1,01 x 1,26 m.</span></p>
                      </Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <p><span>Aluminiumfenster einflügelig, Dreh-Kipp</span></p>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Item ID="I8" RNoPart="0020">
                <Qty>6.000</Qty>
                <QU>Stk</QU>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p><span>Wie Pos. 02.0010, jedoch zweiflügelig, Stulpausführung ohne Mittelpfosten.</span></p>
                        <p><span>Größe 1,76 x 1,26 m. Uw ≤ 0,9 W/m²K.</span></p>
                      </Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <p><span>Aluminiumfenster zweiflügelig mit Stulp</span></p>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Item ID="I9" RNoPart="0030">
                <Qty>4.000</Qty>
                <QU>Stk</QU>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p><span>Profilsystem Serie A75, 3-fach Wärmeschutzglas, Uw max. 1,0 W/(m²K).</span></p>
                        <p><span>Untere Schwelle barrierefrei.</span></p>
                      </Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <p><span>Fenstertür einflügelig, Aluminium</span></p>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Item ID="I10" RNoPart="0040">
                <Qty>18.500</Qty>
                <QU>m2</QU>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p><span>Feststehendes Element in Aluminiumrahmen Serie A75, Verglasung 3-fach Wärmeschutz.</span></p>
                      </Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <p><span>Festverglasung Treppenhaus</span></p>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Item ID="I11" RNoPart="0050">
                <Qty>2.000</Qty>
                <QU>Stk</QU>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p><span>Fenster aus Kunststoffprofilen, weiß, Dreifachverglasung, Uw ≤ 0,90 W/(m²K).</span></p>
                      </Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <p><span>Kunststofffenster einflügelig, Dreh-Kipp</span></p>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Item ID="I12" RNoPart="0060">
                <Qty>6.000</Qty>
                <QU>Stk</QU>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p><span>Zulage zu den Fensterpositionen für Montage in einer Höhe über 4,00 m.</span></p>
                      </Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <p><span>Zulage für Montage über 4 m Höhe</span></p>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Item ID="I13" RNoPart="0070">
                <Qty>14.000</Qty>
                <QU>Stk</QU>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p><span>Vorhandene Holzfenster einschließlich Glas ausbauen, abtransportieren und entsorgen.</span></p>
                      </Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <p><span>Altfenster ausbauen und entsorgen</span></p>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Item ID="I14" RNoPart="0080">
                <Qty>3.000</Qty>
                <QU>Stk</QU>
                <ALNGroupNo>1</ALNGroupNo>
                <ALNSerNo>0</ALNSerNo>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p><span>Profilsystem Serie A75, Oberlicht als Kippflügel, Uw ≤ 0,9 W/(m²K).</span></p>
                      </Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <p><span>Aluminiumfenster einflügelig mit Oberlicht</span></p>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Item ID="I15" RNoPart="0090">
                <Qty>3.000</Qty>
                <QU>Stk</QU>
                <ALNGroupNo>1</ALNGroupNo>
                <ALNSerNo>1</ALNSerNo>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p><span>Alternativ zu Pos. 02.0080: Ausführung zweiflügelig mit Oberlicht.</span></p>
                      </Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <p><span>wie vor, jedoch zweiflügelig</span></p>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
            </Itemlist>
          </BoQBody>
        </BoQCtgy>
        <BoQCtgy ID="C16" RNoPart="03">
          <LblTx>
            <p><span>Türen</span></p>
          </LblTx>
          <BoQBody>
            <Itemlist>
              <Item ID="I17" RNoPart="0010">
                <Qty>1.000</Qty>
                <QU>Stk</QU>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p><span>Haustür aus Aluminium, Profilsystem Serie T75, Widerstandsklasse RC 2 nach DIN EN 1627.</span></p>
                        <p><span>Ud ≤ 1,3 W/(m²K).</span></p>
                      </Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <p><span>Haustür Aluminium, einbruchhemmend</span></p>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Item ID="I18" RNoPart="0020">
                <Qty>3.000</Qty>
                <QU>Stk</QU>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p><span>Feuerschutzabschluss T30, einflügelig, Aluminiumprofile Serie F60, selbstschließend.</span></p>
                      </Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <p><span>Feuerschutztür T30-1</span></p>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Item ID="I19" RNoPart="0030">
                <Qty>1.000</Qty>
                <QU>Stk</QU>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p><span>Feuerschutzabschluss T90, einflügelig, Stahl, selbstschließend.</span></p>
                      </Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <p><span>Feuerschutztür T90-1</span></p>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Item ID="I20" RNoPart="0040">
                <Qty>2.000</Qty>
                <QU>Stk</QU>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p><span>Rauchschutzabschluss RS-2 nach DIN 18095, Aluminium Serie F60, mit Schließfolgeregelung.</span></p>
                      </Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <p><span>Rauchschutztür zweiflügelig</span></p>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Item ID="I21" RNoPart="0050">
                <Qty>1.000</Qty>
                <QU>Stk</QU>
                <Provis>WithTotal</Provis>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p><span>Wie Pos. 03.0020, nur auf Anordnung der Bauleitung.</span></p>
                      </Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <p><span>Feuerschutztür T30-1, Bedarf</span></p>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Item ID="I22" RNoPart="0060">
                <Qty>1.000</Qty>
                <QU>Stk</QU>
                <Provis>WithoutTotal</Provis>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p><span>Zulage für die Montage von Türen in einer Höhe über 4 m, nur auf Anordnung.</span></p>
                      </Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <p><span>Zulage Türmontage über 4 m</span></p>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
            </Itemlist>
          </BoQBody>
        </BoQCtgy>
        <BoQCtgy ID="C23" RNoPart="04">
          <LblTx>
            <p><span>Fensterbänke und Bleche</span></p>
          </LblTx>
          <BoQBody>
            <Itemlist>
              <Item ID="I24" RNoPart="0010">
                <Qty>42.600</Qty>
                <QU>m</QU>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p><span>Außenfensterbank aus Aluminium, gekantet, Ausladung 180 mm, mit Endkappen.</span></p>
                      </Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <p><span>Fensterbank außen, Aluminium</span></p>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Item ID="I25" RNoPart="0020">
                <Qty>30.000</Qty>
                <QU>m</QU>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p><span>Innenfensterbank aus Buche, geölt, Tiefe 250 mm.</span></p>
                      </Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <p><span>Fensterbank innen, Holz</span></p>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Item ID="I26" RNoPart="0030">
                <Qty>64.000</Qty>
                <QU>m</QU>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p><span>Attikaabdeckung aus Aluminiumblech 2 mm, Zuschnitt 500 mm, pulverbeschichtet.</span></p>
                      </Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <p><span>Attikablech Aluminium</span></p>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Item ID="I27" RNoPart="0040">
                <Qty>22.000</Qty>
                <QU>m</QU>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p><span>Seitlicher Anschluss der Fenster an das Mauerwerk mit Aluminiumblech.</span></p>
                      </Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <p><span>Anschlussblech seitlich</span></p>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
            </Itemlist>
          </BoQBody>
        </BoQCtgy>
        <BoQCtgy ID="C28" RNoPart="05">
          <LblTx>
            <p><span>Stahlbau</span></p>
          </LblTx>
          <BoQBody>
            <Itemlist>
              <Item ID="I29" RNoPart="0010">
                <Qty>24.000</Qty>
                <QU>m</QU>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p><span>Treppengeländer aus Stahl, Füllung senkrechte Stäbe, feuerverzinkt, Höhe 1,00 m.</span></p>
                      </Text>
